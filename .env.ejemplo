# Plantilla del .env — ESTE archivo sí se sube al repo, el .env real NO.
#
# Copialo como .env y llenalo con los valores de tu máquina:
#     cp .env.ejemplo .env
#
# Nunca pongas valores reales acá.

# ---- Base de datos (PostgreSQL) ----
BD_HOST=localhost
BD_PUERTO=5432
BD_NOMBRE=la_moran
BD_USUARIO=postgres
BD_CLAVE=

# ---- GitHub ----
# Token personal para que las herramientas puedan empujar a la rama.
GITHUB_TOKEN=
